[Unit]
Description=omen15-fan EC-based fan curve for HP Omen 15-en1xxx (board 88D2)
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe ec_sys write_support=1
ExecStart=/usr/local/bin/omen15-fan curve
Restart=on-failure
RestartSec=2
# Always try to hand control back to the BIOS before the unit goes away.
ExecStopPost=-/usr/local/bin/omen15-fan auto

# Needs raw EC/debugfs + DMI access; not sandboxed beyond the basics.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
